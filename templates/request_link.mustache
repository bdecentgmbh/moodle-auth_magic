{{!
    @template auth_magic/request_link

    Asks for the account to send a magic login link to.

    Context variables required for this template:
    * actionurl - URL that the form posts to
    * logintoken - Login token of the session
    * intro - Explains the form
    * label - Label of the field for the email address or username
    * loginurl - URL of the login page

    Example context (json):
    {
        "actionurl": "https://example.com/auth/magic/login.php",
        "logintoken": "abcdefghijklmnopqrstuvwxyz012345",
        "intro": "Enter the email address of your account. You will get an email with a link that logs you in.",
        "label": "Email address",
        "loginurl": "https://example.com/login/index.php"
    }
}}
<h1 class="login-heading mb-4">{{#str}} requestlinkheading, auth_magic {{/str}}</h1>
<p>{{intro}}</p>
<form action="{{actionurl}}" method="post" id="auth_magic-requestlink">
    <input type="hidden" name="magiclogin" value="1">
    <input type="hidden" name="logintoken" value="{{logintoken}}">
    <div class="mb-3">
        <label for="auth_magic-uservalue" class="form-label">{{label}}</label>
        <input type="text" name="uservalue" id="auth_magic-uservalue" class="form-control" autocomplete="username" required>
    </div>
    <div class="mb-3">
        <button type="submit" class="btn btn-primary">{{#str}} getmagiclinkviagmail, auth_magic {{/str}}</button>
    </div>
</form>
<a href="{{loginurl}}">{{#str}} backtologin, auth_magic {{/str}}</a>
